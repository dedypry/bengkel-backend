<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice {{ trx_no }}</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
            background-color: #f9f9f9;
        }

        .container {
            max-width: 600px;
            margin: 20px auto;
            background: #fff;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #eee;
        }

        .header {
            background-color: #1e293b;
            color: #ffffff;
            padding: 30px;
            text-align: center;
        }

        .header img {
            max-width: 120px;
            margin-bottom: 10px;
            border-radius: 4px;
        }

        .content {
            padding: 25px;
        }

        .section-title {
            font-size: 14px;
            font-weight: bold;
            color: #64748b;
            text-transform: uppercase;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 5px;
            margin-bottom: 15px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        th {
            text-align: left;
            font-size: 12px;
            color: #94a3b8;
            padding: 10px;
            border-bottom: 1px solid #eee;
        }

        td {
            padding: 10px;
            border-bottom: 1px solid #f8fafc;
            font-size: 13px;
        }

        .text-right {
            text-align: right;
        }

        .summary-table {
            margin-left: auto;
            width: 250px;
        }

        .summary-table td {
            border: none;
            padding: 5px 10px;
        }

        .grand-total {
            font-size: 18px;
            font-weight: bold;
            color: #0f172a;
            background: #f1f5f9;
        }

        .promo-badge {
            background: #dcfce7;
            color: #166534;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
        }

        .footer {
            background: #f8fafc;
            padding: 20px;
            text-align: center;
            font-size: 12px;
            color: #64748b;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="header">
            @if(company.logo_url)
            <img src="{{ company.logo_url }}" alt="Logo {{ company.name }}">
            @endif
            <h2 style="margin: 0;">{{ company.name }}</h2>
            <p style="font-size: 12px; opacity: 0.8; margin: 5px 0 0;">{{ company.phone_number }} | {{ company.email }}
            </p>
        </div>

        <div class="content">
            <div style="text-align: center; margin-bottom: 25px;">
                <h3 style="margin: 0; color: #1e293b;">INVOICE LAYANAN</h3>
                <p style="font-size: 14px; color: #64748b; margin: 5px 0;">No: <strong>{{ trx_no }}</strong></p>
            </div>

            <div class="grid">
                <div>
                    <div class="section-title">Pelanggan</div>
                    <strong>{{ customer.name }}</strong><br>
                    <span style="font-size: 13px; color: #64748b;">{{ customer.phone }}</span>
                </div>
                <div>
                    <div class="section-title">Kendaraan</div>
                    <strong>{{ vehicle.plate_number }}</strong><br>
                    <span style="font-size: 13px; color: #64748b;">{{ vehicle.brand }} {{ vehicle.model }} ({{
                        current_km }} KM)</span>
                </div>
            </div>

            <div class="section-title">Detail Pengerjaan</div>
            <table>
                <thead>
                    <tr>
                        <th>ITEM</th>
                        <th class="text-right">QTY</th>
                        <th class="text-right">TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    {{-- Services Section --}}
                    @each(item in services)
                    @if(Number(item.price) > 0)
                    <tr>
                        <td>{{ item.data.name }} <br><small style="color:#94a3b8">Jasa</small></td>
                        <td class="text-right">{{ item.qty }}</td>
                        <td class="text-right">Rp{{ Number(item.total_price).toLocaleString('id-ID') }}</td>
                    </tr>
                    @endif
                    @endeach

                    {{-- Spareparts Section --}}
                    @each(item in spareparts)
                    <tr>
                        <td>{{ item.data.name }} <br><small style="color:#94a3b8">Suku Cadang</small></td>
                        <td class="text-right">{{ item.qty }}</td>
                        <td class="text-right">Rp{{ Number(item.total_price).toLocaleString('id-ID') }}</td>
                    </tr>
                    @endeach
                </tbody>
            </table>

            <table class="summary-table">
                <tr>
                    <td>Subtotal</td>
                    <td class="text-right">Rp{{ Number(sub_total).toLocaleString('id-ID') }}</td>
                </tr>
                @if(Number(promo_amount) > 0)
                <tr>
                    <td>
                        Promo
                        <span class="promo-badge">{{ promo_data[0].code }}</span>
                    </td>
                    <td class="text-right" style="color: #dc2626;">-Rp{{ Number(promo_amount).toLocaleString('id-ID') }}
                    </td>
                </tr>
                @endif
                <tr>
                    <td>PPN ({{ ppn_percent }}%)</td>
                    <td class="text-right">Rp{{ Number(ppn_amount).toLocaleString('id-ID') }}</td>
                </tr>
                <tr class="grand-total">
                    <td>TOTAL</td>
                    <td class="text-right">Rp{{ Number(grand_total).toLocaleString('id-ID') }}</td>
                </tr>
            </table>

            @if(company.is_discount_birth_day && promo_data.length > 0)
            <div
                style="background: #fffbeb; border: 1px solid #fde68a; padding: 10px; border-radius: 6px; font-size: 12px; color: #92400e;">
                ✨ <strong>Promo Terpasang:</strong> Selamat! Kendaraan Anda mendapatkan diskon khusus {{
                promo_data[0].name }}.
            </div>
            @endif
        </div>

        <div class="footer">
            <p style="margin: 0;">Terima kasih atas kunjungan Anda!</p>
            <p style="margin: 5px 0 0;">Pembayaran dapat dilakukan melalui kasir bengkel atau transfer sesuai instruksi
                petugas.</p>
        </div>
    </div>
</body>

</html>