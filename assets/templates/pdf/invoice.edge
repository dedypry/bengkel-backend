<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice - {{ trx_no }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Poppins', 'sans-serif'] },
                    colors: { primary: '#13748f' }
                }
            }
        }
    </script>
    <style>
        /* Elemen ini tidak terlihat, tapi memaksa margin jika terjadi page break */
        .page-spacer {
            break-before: page;
            height: 50px;
            display: block;
        }
    </style>
    <style>
        @media print {
            thead {
                display: table-header-group;
            }

            /* Ini kunci agar header muncul di tiap halaman */
            tfoot {
                display: table-footer-group;
            }

            body {
                -webkit-print-color-adjust: exact;
            }
        }

        body {
            font-family: 'Poppins', sans-serif;
        }

        /* Menghilangkan margin default browser saat print */
        @page {
            margin: 10mm;
        }
    </style>
</head>

<body>
    <div class=" overflow-hidden">

        <header class="flex justify-between items-center border-b-2 border-primary pb-4 mb-6" >
            <div class="flex items-center gap-4">
                @if(company.logo_url)
                <img src="{{ company.logo_url }}" alt="Logo" class="h-16 w-auto object-contain">
                @else
                <div class="h-16 w-16 bg-slate-200 flex items-center justify-center rounded text-[10px] text-slate-400">
                    NO LOGO</div>
                @endif

                <div class="max-w-md">
                    <h2 class="text-xl font-extrabold text-primary leading-tight uppercase">{{ company.name }}</h2>
                    <p class="text-[10px] text-slate-600 leading-tight mt-1">{{ company.address || "" }}</p>

                    <div class="flex flex-wrap gap-x-3 gap-y-0 text-[10px] text-slate-500 mt-1 font-medium">
                        @if(company.phone_number)
                        <span>Telp: {{ company.phone_number }}</span>
                        @endif
                        @if(company.fax)
                        <span>Fax: {{ company.fax }}</span>
                        @endif
                        @if(company.email)
                        <span>Email: {{ company.email }}</span>
                        @endif
                    </div>
                </div>
            </div>

            <div class="text-right">
                <h1 class="text-3xl font-black text-slate-800 tracking-tighter">INVOICE</h1>
                <div class="bg-primary text-white px-2 py-0.5 rounded text-[10px] font-mono mt-1 inline-block">
                    {{ trx_no }}
                </div>
            </div>
        </header>


        <div>
            <div class="grid grid-cols-2 gap-12 mb-10">
                <div>
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">Tagihan Untuk:</h3>
                    <p class="text-lg font-bold text-slate-800">{{ customer.name }}</p>
                    <p class="text-xs text-slate-500 mt-1">{{ customer.profile.address || 'No address provided' }}</p>
                    <p class="text-xs font-medium text-primary mt-2">{{ customer.phone }}</p>
                </div>
                <div class="bg-slate-50 p-2 w-full rounded-xl border border-slate-200">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3 text-center">Data
                        Kendaraan</h3>
                    <div class="grid grid-cols-2 gap-y-2 text-xs">
                        <span class="text-slate-500 italic">No. Polisi</span>
                        <span class="font-bold text-right text-slate-800 uppercase">{{ vehicle.plate_number }}</span>
                        <span class="text-slate-500 italic">Model</span>
                        <span class="font-bold text-right text-slate-800 uppercase">{{ vehicle.brand }} {{ vehicle.model
                            }}</span>
                        <span class="text-slate-500 italic">Kilometer</span>
                        <span class="font-bold text-right text-slate-800">{{ current_km.toLocaleString() }} KM</span>
                    </div>
                </div>
            </div>

            @if(services.length > 0)
            <div class="mb-8">
                <div class="flex items-center mb-3">
                    <span
                        class="bg-primary text-white text-[10px] px-2 py-0.5 rounded-full font-bold mr-2 uppercase tracking-tighter">JASA</span>
                    <h4 class="text-xs font-bold text-slate-700 uppercase">Layanan & Pekerjaan</h4>
                </div>
                <table class="w-full">
                    <thead class="bg-slate-50 border-y border-slate-100">
                        <tr class="text-left text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                            <th class="py-1.5 px-4" style="width: 450px;">Deskripsi Service</th>
                            <th class="py-1.5 px-4 text-center w-16">Qty</th>
                            <th class="py-1.5 px-4 text-right">Biaya</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @each(service in services)
                        <tr class="text-xs">
                            <td class="py-1.5 px-4 text-slate-700 font-medium italic">{{ service.data.name }}</td>
                            <td class="py-1.5 px-4 text-center text-slate-500">{{ service.qty }}</td>
                            <td class="py-1.5 px-4 text-right font-semibold text-slate-800 italic">
                                {{ Number(service.total_price).toLocaleString('id-ID') }}
                            </td>
                        </tr>
                        @end
                    </tbody>
                </table>
            </div>
            @end

            @if(spareparts.length > 0)
            <div class="mb-10">
                <div class="flex items-center mb-3">
                    <span
                        class="bg-amber-500 text-white text-[10px] px-2 py-0.5 rounded-full font-bold mr-2 uppercase tracking-tighter">PARTS</span>
                    <h4 class="text-xs font-bold text-slate-700 uppercase tracking-tighter">Penggantian Suku Cadang</h4>
                </div>
                <table class="w-full">
                    <thead class="bg-slate-50 border-y border-slate-100">
                        <tr class="text-left text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                            <th class="py-1.5 px-4" style="width: 450px;">Nama Barang</th>
                            <th class="py-1.5 px-4 text-center w-16 text-xs uppercase">Qty</th>
                            <th class="py-1.5 px-4 text-right">Harga Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @each(part in spareparts)
                        <tr class="text-xs">
                            <td class="py-1.5 px-4">
                                <div class="font-medium text-slate-700">{{ part.data.name }}</div>
                                <div class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">{{
                                    part.data.code }}</div>
                            </td>
                            <td class="py-1.5 px-4 text-center text-slate-500">{{ part.qty }}</td>
                            <td class="py-1.5 px-4 text-right font-semibold text-slate-800 italic">
                                {{ Number(part.total_price).toLocaleString('id-ID') }}
                            </td>
                        </tr>
                        @end
                    </tbody>
                </table>
            </div>
            @end

            <div class="flex justify-between pt-6 border-t border-slate-200 gap-4 pr-5">
                <div class="w-full md:w-1/2">
                    <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                        <h4 class="text-[10px] uppercase tracking-widest font-bold text-slate-400 mb-2 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                class="lucide lucide-clipboard-check">
                                <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
                                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                                <path d="m9 14 2 2 4-4" />
                            </svg>
                            Rekomendasi Servis Mendatang
                        </h4>
                
                        <div class="prose prose-slate prose-sm max-w-none text-slate-600 leading-relaxed next-suggestion-content text-xs text-gray-500">
                            @if(next_sugestion && next_sugestion !== '<p></p>')
                            {{{ next_sugestion }}}
                            @else
                            <p class="italic text-slate-400 text-xs">Tidak ada rekomendasi tambahan untuk kunjungan ini.</p>
                            @endif
                        </div>
                    </div>
                </div>
                <div class="w-full md:w-1/2 space-y-3">
                    <div class="flex justify-between text-xs">
                        <span class="text-slate-400 italic font-medium">Sub-total Service & Parts</span>
                        <span class="text-slate-700 font-bold tracking-tight">Rp {{
                            Number(sub_total).toLocaleString('id-ID') }}</span>
                    </div>
                    @if(promo_data && promo_data.length > 0)
                    @each(promo in promo_data)
                    <div class="flex justify-between text-xs">
                        <span class="text-rose-400 italic font-medium">{{promo.name}}</span>
                        <span class="text-rose-700 font-bold tracking-tight">Rp {{
                            Number(promo.price || 0).toLocaleString('id-ID') }}</span>
                    </div>
                    @end
                    @end
                    <div class="flex justify-between text-xs">
                        <span class="text-slate-400 italic font-medium tracking-tight uppercase">Pajak PPN ({{
                            ppn_percent }}%)</span>
                        <span class="text-slate-700 font-bold tracking-tight text-xs uppercase italic">Rp {{
                            Number(ppn_amount).toLocaleString('id-ID') }}</span>
                    </div>
                    <div class="flex justify-between items-center py-2 px-3 bg-primary rounded-xl text-white">
                        <span class="font-black uppercase text-xs tracking-widest">Grand Total</span>
                        <span class="font-black text-sm tracking-widest italic">Rp {{
                            Number(grand_total).toLocaleString('id-ID') }}</span>
                    </div>
                </div>
            </div>

            <div class="mt-20 flex justify-between items-end border-t border-dashed border-slate-200 pt-10"
                style="page-break-inside: avoid; break-inside: avoid;">
            <div class="text-[10px] text-slate-400 uppercase tracking-widest leading-loose">
                <p class="font-bold text-slate-600 mb-2 underline tracking-tighter italic">PENTING:</p>
                <p>1. Simpan invoice ini sebagai bukti garansi service.</p>
                <p>2. Garansi berlaku 7 hari kerja atau 1.000 KM.</p>
                <p>3. Sparepart elektrik tidak dapat ditukar kembali.</p>
            </div>
            {{-- <div class="text-center">
                <p class="text-[11px] font-bold text-slate-400 mb-16 uppercase italic">Kasir/Kepala Bengkel,</p>
                <div class="w-48 border-b-2 border-slate-800"></div>
                <p class="mt-2 text-[10px] font-black text-primary italic uppercase tracking-widest">
                </p>
            </div> --}}
        </div>
    </div>
    </div>
</body>

</html>